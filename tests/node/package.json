{
  "name": "db2-node-tests",
  "private": true,
  "scripts": {
    "test": "npm run test:api-types && node --import tsx --test ./*.test.ts ./*.test.mjs",
    "test:connection": "node --import tsx --test ./connection.test.ts",
    "test:query": "node --import tsx --test ./query.test.ts",
    "test:types": "node --import tsx --test ./data-types.test.ts",
    "test:load": "node --test ./module-load.test.mjs",
    "test:txn": "node --import tsx --test ./transaction.test.ts",
    "test:error": "node --import tsx --test ./error-handling.test.ts",
    "test:ddl": "node --import tsx --test ./ddl-dml.test.ts",
    "test:api-types": "tsc --strict --noEmit --target es2022 --module node16 --moduleResolution node16 --types node query-api.types.ts",
    "test:downstream-types": "node --test ./downstream-types.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.0.0",
    "typescript": "5.9.3"
  }
}
